{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "briefing_id": {
      "type": "string"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "worktree"
            },
            "base": {
              "type": "string",
              "pattern": "^[0-9a-f]{4,64}$"
            },
            "head": {
              "type": "string",
              "const": "WORKTREE"
            }
          },
          "required": ["kind", "base", "head"]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "commit"
            },
            "base": {
              "type": "string",
              "pattern": "^[0-9a-f]{4,64}$"
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{4,64}$"
            }
          },
          "required": ["kind", "base", "head"]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "range"
            },
            "base": {
              "type": "string",
              "pattern": "^[0-9a-f]{4,64}$"
            },
            "head": {
              "type": "string",
              "pattern": "^[0-9a-f]{4,64}$"
            }
          },
          "required": ["kind", "base", "head"]
        }
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "status": {
      "type": "string",
      "enum": ["partial", "complete"]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["stage", "message"]
      }
    },
    "enrich": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "quality": {
          "type": "object",
          "properties": {
            "suspects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rewritten": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "dropped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["suspects", "rewritten", "dropped"]
        }
      },
      "required": ["provider", "prompt_version"]
    },
    "briefing": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "requirement": {
              "type": "string"
            },
            "approach": {
              "type": "string"
            },
            "skipped_alternatives": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "assumptions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "not_run": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "followups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ask": {
                    "type": "string"
                  },
                  "preset": {
                    "type": "string",
                    "enum": [
                      "explain_more",
                      "why_not_another_way",
                      "what_could_break",
                      "where_used"
                    ]
                  },
                  "answer": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["recorded", "reconstructed"]
                  },
                  "cite_msg_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ts": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                },
                "required": ["ask", "answer", "kind", "ts"]
              }
            }
          },
          "required": ["requirement", "approach", "skipped_alternatives", "assumptions", "not_run"]
        },
        {
          "type": "null"
        }
      ]
    },
    "read_first": {
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "entry": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "role": {
                  "type": "string",
                  "enum": ["problem", "blocker", "enabling", "change", "proof"]
                },
                "layer": {
                  "type": "string"
                },
                "hunks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tests": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "hands_off": {
                  "type": "string"
                },
                "followups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ask": {
                        "type": "string"
                      },
                      "preset": {
                        "type": "string",
                        "enum": [
                          "explain_more",
                          "why_not_another_way",
                          "what_could_break",
                          "where_used"
                        ]
                      },
                      "answer": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "enum": ["recorded", "reconstructed"]
                      },
                      "cite_msg_ids": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "ts": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                      }
                    },
                    "required": ["ask", "answer", "kind", "ts"]
                  }
                }
              },
              "required": ["step", "role", "hunks", "hands_off"]
            }
          }
        },
        "required": ["id", "title", "entry", "path"]
      }
    },
    "off_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["deleted_test", "weakened_test", "unexplained", "failed_not_rerun"]
          },
          "hunks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "detail": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": ["rules", "log"]
          }
        },
        "required": ["kind", "detail", "source"]
      }
    },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "serves": {
            "type": "string"
          },
          "source_msg": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "session": {
                    "type": "string"
                  },
                  "msg_id": {
                    "type": "string"
                  },
                  "quote": {
                    "type": "string"
                  }
                },
                "required": ["session", "msg_id", "quote"]
              },
              {
                "type": "null"
              }
            ]
          },
          "link_confidence": {
            "type": "string",
            "enum": ["high", "low"]
          }
        },
        "required": ["id", "why", "serves", "source_msg"]
      }
    },
    "hunks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "old_path": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["added", "modified", "deleted", "renamed", "binary"]
          },
          "old_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "old_lines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "new_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "new_lines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "content_hash": {
            "type": "string"
          },
          "why": {
            "type": ["string", "null"]
          },
          "intent_id": {
            "type": ["string", "null"]
          },
          "intent_history": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "serves": {
            "type": "string",
            "const": "unexplained"
          },
          "external_touched": {
            "type": "boolean"
          },
          "drift": {
            "type": "boolean"
          },
          "exec": {
            "type": "string",
            "enum": ["tested", "ran", "never_executed"]
          },
          "risk": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "object",
            "properties": {
              "why": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": ["llm", "quote"]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "exec": {
                "type": "string",
                "const": "log"
              },
              "risk": {
                "type": "string",
                "const": "rules"
              }
            },
            "required": ["why", "exec", "risk"]
          },
          "followups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ask": {
                  "type": "string"
                },
                "preset": {
                  "type": "string",
                  "enum": ["explain_more", "why_not_another_way", "what_could_break", "where_used"]
                },
                "answer": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["recorded", "reconstructed"]
                },
                "cite_msg_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ts": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                }
              },
              "required": ["ask", "answer", "kind", "ts"]
            }
          }
        },
        "required": [
          "id",
          "path",
          "status",
          "old_start",
          "old_lines",
          "new_start",
          "new_lines",
          "content_hash",
          "why",
          "intent_id",
          "intent_history",
          "external_touched",
          "drift",
          "exec",
          "risk",
          "source"
        ]
      }
    }
  },
  "required": [
    "v",
    "briefing_id",
    "target",
    "sessions",
    "generated_at",
    "status",
    "errors",
    "enrich",
    "briefing",
    "read_first",
    "concepts",
    "off_path",
    "warnings",
    "intents",
    "hunks"
  ]
}
